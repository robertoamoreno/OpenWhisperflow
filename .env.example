# OpenWhisperflow development environment
# Copy to .env or export these in your shell. Do not commit real keys.

# Together AI ASR provider
TOGETHER_API_KEY=

# Anthropic-compatible LLM provider
ANTHROPIC_API_KEY=

# Optional LiteLLM or Anthropic-compatible proxy base URL
# Example: http://127.0.0.1:4000
ANTHROPIC_BASE_URL=
